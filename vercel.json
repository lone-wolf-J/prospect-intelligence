{
  "version": 2,
  "builds": [
    {
      "src": "prospect-intelligence/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "prospect-intelligence/dist",
        "installCommand": "cd prospect-intelligence && npm install",
        "buildCommand": "cd prospect-intelligence && npm run build:vercel"
      }
    },
    {
      "src": "prospect-intelligence/api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/prospect-intelligence/api/$1" },
    { "src": "/assets/(.*)", "dest": "/prospect-intelligence/dist/assets/$1" },
    { "src": "/(.*)", "dest": "/prospect-intelligence/dist/$1" }
  ],
  "installCommand": "cd prospect-intelligence && npm install",
  "buildCommand": "cd prospect-intelligence && npm run build:vercel",
  "outputDirectory": "prospect-intelligence/dist"
}